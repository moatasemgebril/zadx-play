{
  "Guard": {
    "FunctionsBaseUrl": "https://europe-west1-YOUR_FIREBASE_PROJECT.cloudfunctions.net",
    "PolicyRefreshSeconds": 60,
    "ScanIntervalSeconds": 4,
    "PrayerLockMinutes": 15,
    "BlockLaunchersWhenLocked": true
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.Hosting.Lifetime": "Information" },
    "EventLog": { "SourceName": "Zad X Guard", "LogName": "Application" }
  }
}
