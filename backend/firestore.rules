rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(familyId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
    }
    // Written only by Cloud Functions (admin SDK): entitlement, referral, membership.
    function serverOnlyFamilyKeys() {
      return ['plan', 'planExpiresAt', 'inTrial', 'store', 'purchaseToken', 'referrals', 'referredBy',
              'referralPaid', 'referralCode', 'members', 'childDevices', 'parentDevices', 'createdAt'];
    }
    // Shape of a synced day (lib/services/family/family_repository.dart FamilyDay).
    function validDay(day) {
      let d = request.resource.data;
      return d.size() <= 20
        && (!('day' in d) || d.day == day)
        && (!('earnedMinutes' in d) || (d.earnedMinutes is int && d.earnedMinutes >= 0 && d.earnedMinutes <= 100000))
        && (!('usedMinutes' in d) || (d.usedMinutes is int && d.usedMinutes >= 0 && d.usedMinutes <= 100000))
        && (!('requiredDone' in d) || d.requiredDone is bool)
        && (!('prayerLock' in d) || d.prayerLock is bool)
        && (!('prayerLockSinceMs' in d) || (d.prayerLockSinceMs is int && d.prayerLockSinceMs >= 0))
        && (!('progress' in d) || (d.progress is map && d.progress.size() <= 100));
    }

    // R-32: what a paired CHILD device may change on its own day doc (`before` = stored doc, {} on create).
    // It may request a task (todo -> pending), add play time and start a prayer lock. Approvals ("done"),
    // earnedMinutes, requiredDone and ending a prayer lock are parent-only.
    // App side: ChildDayPatch in lib/services/family/family_repository.dart.
    function childDayKeys() {
      return ['day', 'progress', 'childTask', 'usedMinutes', 'prayerLock', 'prayerLockSinceMs', 'updatedAt', 'updatedBy'];
    }
    // One progress entry written by a child device: todo or pending only, never done.
    function childTaskEntry(e) {
      return e is map && e.keys().hasOnly(['status', 'count'])
        && e.get('status', 'todo') in ['todo', 'pending']
        && (!('count' in e) || (e.count is int && e.count >= 0 && e.count <= 10000));
    }
    function childDayWrite(before) {
      let d = request.resource.data;
      let changed = d.diff(before).affectedKeys();
      let newProgress = d.get('progress', {});
      let taskChanges = newProgress.diff(before.get('progress', {})).affectedKeys();
      return changed.hasOnly(childDayKeys())
        // At most one task per write, named in childTask (rules cannot loop over a map).
        && (taskChanges.size() == 0
          || ('childTask' in d && d.childTask is string && taskChanges.hasOnly([d.childTask])
            && d.childTask in newProgress && childTaskEntry(newProgress[d.childTask])))
        // Play time only goes up.
        && d.get('usedMinutes', 0) >= before.get('usedMinutes', 0)
        // A child device may start a prayer lock, never end it.
        && (!changed.hasAny(['prayerLock']) || d.prayerLock == true)
        && (!changed.hasAny(['prayerLockSinceMs']) || d.get('prayerLock', false) == true)
        && (!changed.hasAny(['updatedAt']) || d.updatedAt == request.time)
        && (!changed.hasAny(['updatedBy']) || d.updatedBy == request.auth.uid);
    }

    // ---- Multi-child -------------------------------------------------------
    // families/{id}.childDevices = { uid: childId } is written only by Cloud Functions
    // (redeemPairingCode). A member listed there is a child device bound to one child;
    // any other member is a parent device.
    function boundChildOf(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data.get('childDevices', {}).get(request.auth.uid, null);
    }
    function isParent(familyId) {
      return isMember(familyId) && boundChildOf(familyId) == null;
    }
    function isChildDevice(familyId, childId) {
      return isMember(familyId) && boundChildOf(familyId) == childId;
    }
    function validChildId(childId) {
      return childId.matches('^[A-Za-z0-9_-]{1,40}$');
    }
    // COPPA data minimisation: nickname + built-in avatar id only.
    function validChildProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nickname', 'avatar', 'updatedAt'])
        && d.nickname is string && d.nickname.size() <= 40
        && d.avatar is string && d.avatar.matches('^[a-z]{1,16}$')
        && (!('updatedAt' in d) || d.updatedAt == request.time);
    }
    // -----------------------------------------------------------------------

    match /families/{familyId} {
      // Every member reads the family doc, child devices included: that is how a child device
      // gets the plan the parent paid for (plan, planExpiresAt, inTrial, store). Those fields stay
      // server-only (serverOnlyFamilyKeys). The raw store token is NOT on this doc (private/billing).
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // A new family has exactly one member (the creator) and no entitlement / referral fields.
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && !request.resource.data.keys().hasAny(serverOnlyFamilyKeys().removeAll(['members', 'createdAt']))
        && (!('settings' in request.resource.data) || request.resource.data.settings is map);
      // Plan, referral, purchase and membership fields are written only by Cloud Functions (admin SDK).
      allow update: if isMember(familyId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyFamilyKeys())
        // parentDevices {uid: linkedAt}: written only by redeemPairingCode (parent code).
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['parentDevices'])
        && (!('settings' in request.resource.data) || request.resource.data.settings is map)
        // R-33: only parent devices change the family doc, `settings` included (lockAtAdhan,
        // controlled games, time zone, parent pushes). Child devices only read it.
        && isParent(familyId);

      // Multi-child: parents manage every child; a paired child device sees only its own child.
      match /children/{childId} {
        allow read: if isParent(familyId) || isChildDevice(familyId, childId);
        allow create, update: if isParent(familyId) && validChildId(childId) && validChildProfile();
        allow delete: if isParent(familyId);

        match /days/{day} {
          allow read: if isParent(familyId) || isChildDevice(familyId, childId);
          // Parent-only: a child device could otherwise delete the day and recreate it unlocked.
          allow delete: if isParent(familyId);
          // Parents write everything (approvals, earnedMinutes, requiredDone, ending a prayer lock).
          allow create, update: if isParent(familyId) && validDay(day);
          // R-32: the paired child device writes only what childDayWrite allows.
          allow create: if isChildDevice(familyId, childId) && validDay(day) && childDayWrite({});
          allow update: if isChildDevice(familyId, childId) && validDay(day) && childDayWrite(resource.data);
        }
      }

      // Windows guard devices: created and read by Cloud Functions only.
      match /devices/{deviceId} {
        allow read, write: if false;
      }

      match /assistantUsage/{day} {
        allow read: if isMember(familyId);
        allow write: if false;
      }

      // private/billing = { purchaseToken } (raw store token): Cloud Functions only.
      match /private/{docId} {
        allow read, write: if false;
      }
    }

    // purchases/{sha256(store token)} = { familyId, store } (verifyPurchase ownership): Cloud Functions only.
    match /purchases/{tokenHash} {
      allow read, write: if false;
    }

    match /pairingCodes/{code} {
      allow read, write: if false;
    }

    match /referralCodes/{code} {
      allow read, write: if false;
    }

    // Tamper-alert heartbeats (Cloud Functions only). docs/decisions/DEVICE-PROTECTION.md
    match /deviceHeartbeats/{id} {
      allow read, write: if false;
    }

    // Rate-limit counters (Cloud Functions only). Anything not matched above is denied by default.
    match /rateLimits/{key} {
      allow read, write: if false;
    }
  }
}
