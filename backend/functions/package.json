{
  "name": "zadx-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": { "node": "20" },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/security.test.js test/approvals.test.js test/apple.test.js",
    "test:rules:deps": "npm install --no-save --no-audit --no-fund @firebase/rules-unit-testing@4 firebase@11",
    "test:rules": "firebase emulators:exec --only firestore --project demo-zadx \"node --test test/rules.test.js\"",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions,firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^1.4.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.1",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "typescript": "^5.6.3"
  }
}
